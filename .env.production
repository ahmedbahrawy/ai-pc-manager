# App
NEXT_PUBLIC_APP_URL=https://your-production-domain.com
NEXT_PUBLIC_APP_ENV=production

# API
NEXT_PUBLIC_API_URL=https://api.your-production-domain.com

# Analytics
NEXT_PUBLIC_GA_TRACKING_ID=UA-XXXXXXXXX-X

# Feature Flags
NEXT_PUBLIC_FEATURE_FLAGS={"enableNewUI":true,"enableAnalytics":true}

# Cache
NEXT_PUBLIC_CACHE_MAX_AGE=31536000

# CDN
NEXT_PUBLIC_CDN_URL=https://cdn.your-production-domain.com

# Security
NEXT_PUBLIC_CSP_DOMAINS="*.your-production-domain.com *.vercel.app"

DATABASE_URL=postgresql://production-db:5432/myapp_prod 