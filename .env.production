# Application
NEXT_PUBLIC_APP_URL=https://ai-pc-manager.vercel.app
NEXT_PUBLIC_APP_NAME="AI PC Manager"
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=https://ai-pc-manager.vercel.app/api

# Analytics and Monitoring
NEXT_PUBLIC_GA_TRACKING_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=

# API Keys and Services (Use secure environment variables in your deployment platform)
# DO NOT commit sensitive keys here
API_KEY=
API_SECRET=

# Cache and Performance
NEXT_PUBLIC_CDN_URL=
CACHE_TTL=31536000

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_ERROR_REPORTING=true
NEXT_PUBLIC_FEATURE_FLAGS={"enableNewUI":true,"enableAnalytics":true,"enableErrorReporting":true}

# Cache
NEXT_PUBLIC_CACHE_MAX_AGE=31536000

# Security
NEXT_PUBLIC_CSP_DOMAINS="*.vercel.app"

DATABASE_URL=postgresql://production-db:5432/myapp_prod 